@page "/"
@using System.Globalization
@using GastosApp.Client.Services
@inject AuthService Auth
@inject AccountService Accounts
@inject ExpenseService Expenses
@inject NavigationManager Nav

<PageTitle>Inicio</PageTitle>

@if (isChecking)
{
    <p class="text-center mt-4">Cargando...</p>
}
else
{
    <div class="home-container stagger">

        @* Botón logout discreto arriba *@
        <div class="d-flex justify-content-end mb-2">
            <button class="btn btn-sm btn-link text-muted text-decoration-none"
                    @onclick="HandleLogout">
                Cerrar sesión
            </button>
        </div>

        @* Hero: saludo + resumen *@
        <div class="hero">
            <p class="hero-greeting">@Greeting</p>
            <h1 class="hero-title">Bienvenido de vuelta</h1>

            <div class="hero-summary">
                <span class="hero-summary-label">Gastado este mes</span>
                <span class="hero-summary-value money">@FormatMoney(monthTotal)</span>
            </div>
        </div>

        @* CTA principal: añadir gasto *@
        <a href="nuevo-gasto" class="cta-card cta-primary">
            <div class="cta-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                </svg>
            </div>
            <div class="cta-body">
                <div class="cta-title">Añadir gasto</div>
                <div class="cta-subtitle">Registra un gasto nuevo</div>
            </div>
        </a>

        @* Dashboard: destacado como segunda card *@
        <a href="dashboard" class="cta-card">
            <div class="cta-icon-secondary">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M1 11a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1zm5-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1zm5-5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1z"/>
                </svg>
            </div>
            <div class="cta-body">
                <div class="cta-title">Dashboard</div>
                <div class="cta-subtitle text-muted">Evolución y reparto de gastos</div>
            </div>
        </a>

        @* CTAs secundarios en grid de 2 *@
        <div class="cta-grid">
            <a href="mes" class="cta-card">
                <div class="cta-icon-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M14 0H2a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zM1 3.857C1 3.384 1.448 3 2 3h12c.552 0 1 .384 1 .857v10.286c0 .473-.448.857-1 .857H2c-.552 0-1-.384-1-.857V3.857z"/>
                        <path d="M6.5 7a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm3 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm3 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm-9 3a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm3 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm3 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm3 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm-9 3a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm3 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm3 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/>
                    </svg>
                </div>
                <div class="cta-body">
                    <div class="cta-title-sm">Vista del mes</div>
                </div>
            </a>

            <a href="categorias" class="cta-card">
                <div class="cta-icon-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M4.5 11.5A.5.5 0 0 1 5 11h10a.5.5 0 0 1 0 1H5a.5.5 0 0 1-.5-.5zm-2-4A.5.5 0 0 1 3 7h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm-2-4A.5.5 0 0 1 1 3h10a.5.5 0 0 1 0 1H1a.5.5 0 0 1-.5-.5z"/>
                    </svg>
                </div>
                <div class="cta-body">
                    <div class="cta-title-sm">Categorías</div>
                </div>
            </a>
        </div>
    </div>
}

<style>
    .home-container {
        max-width: 560px;
        margin: 0 auto;
        padding: 4px 0 8px;
    }

    .hero { margin-bottom: 22px; }

    .hero-greeting {
        color: var(--text-muted);
        margin: 0;
        font-size: 0.95rem;
    }

    .hero-title {
        font-size: 1.7rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin: 2px 0 20px;
        color: var(--text);
    }

    /* Tarjeta-resumen: el número es el protagonista de la pantalla */
    .hero-summary {
        position: relative;
        overflow: hidden;
        background-image: var(--accent-gradient);
        border-radius: var(--r-lg);
        padding: 22px 24px;
        color: #fff;
        box-shadow: var(--shadow-glow);
    }
    /* Brillo decorativo en la esquina */
    .hero-summary::after {
        content: "";
        position: absolute;
        top: -45%;
        right: -8%;
        width: 200px;
        height: 200px;
        background: radial-gradient(circle, rgba(255, 255, 255, 0.28), transparent 70%);
        pointer-events: none;
    }

    .hero-summary-label {
        display: block;
        font-size: 0.78rem;
        opacity: 0.85;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 600;
    }

    .hero-summary-value {
        display: block;
        font-size: 2.3rem;
        margin-top: 6px;
    }

    /* CTAs como tarjetas */
    .cta-card {
        display: flex;
        align-items: center;
        gap: 14px;
        background: var(--surface-1);
        border: 1px solid var(--border);
        border-radius: var(--r-md);
        padding: 16px 18px;
        margin-bottom: 12px;
        text-decoration: none;
        color: var(--text);
        box-shadow: var(--shadow-sm);
        transition: transform 0.15s ease, box-shadow 0.15s ease,
                    border-color 0.15s ease, background 0.15s ease;
    }

    .cta-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
        border-color: var(--border-strong);
        background: var(--surface-2);
        color: var(--text);
    }

    .cta-primary {
        background-image: var(--accent-gradient);
        border: none;
        color: #fff;
        box-shadow: 0 8px 22px rgba(99, 102, 241, 0.35);
    }

    .cta-primary:hover {
        background-image: var(--accent-gradient);
        color: #fff;
        box-shadow: 0 10px 26px rgba(99, 102, 241, 0.45);
    }

    .cta-icon {
        background: rgba(255, 255, 255, 0.18);
        color: #fff;
        border-radius: 12px;
        padding: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .cta-icon-secondary {
        background: var(--accent-soft);
        color: var(--accent-hover);
        border-radius: 12px;
        padding: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .cta-body { flex: 1; min-width: 0; }

    .cta-title { font-weight: 700; font-size: 1.05rem; }

    .cta-subtitle {
        font-size: 0.85rem;
        margin-top: 1px;
        color: var(--text-muted);
    }
    .cta-primary .cta-subtitle { color: rgba(255, 255, 255, 0.85); }

    .cta-title-sm { font-weight: 700; font-size: 0.95rem; }

    .cta-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-top: 4px;
    }

    .cta-grid .cta-card { margin-bottom: 0; }
</style>

@code {
    private bool isChecking = true;
    private decimal monthTotal = 0;

    // TODO: cuando entre Marta y queramos share_percent dinámico, leerlo de
    // account_members. Por ahora mi parte en la cuenta compartida es 50%.
    private const decimal MyShareInShared = 0.5m;

    private string Greeting => DateTime.Now.Hour switch
    {
        < 6  => "Buenas noches",
        < 13 => "Buenos días",
        < 21 => "Buenas tardes",
        _    => "Buenas noches"
    };

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn)
        {
            Nav.NavigateTo("login");
            return;
        }

        var accounts = await Accounts.GetMyAccountsAsync();
        if (accounts.Count < 2)
        {
            Nav.NavigateTo("setup");
            return;
        }

        // Resumen rápido: coste real del usuario este mes.
        // La cuenta personal cuenta al 100%; la compartida solo mi parte (50%).
        try
        {
            var today = DateTime.Today;
            var expenses = await Expenses.GetByMonthAsync(today.Year, today.Month);

            // IDs de las cuentas compartidas, para saber a qué gasto aplicar el split.
            var sharedAccountIds = accounts
                .Where(a => a.IsShared)
                .Select(a => a.Id)
                .ToHashSet();

            monthTotal = expenses.Sum(e =>
                sharedAccountIds.Contains(e.AccountId)
                    ? e.Amount * MyShareInShared
                    : e.Amount);
        }
        catch
        {
            // Si falla el resumen, no rompemos la pantalla.
            monthTotal = 0;
        }

        isChecking = false;
    }

    private async Task HandleLogout()
    {
        await Auth.SignOutAsync();
        Nav.NavigateTo("login");
    }

    private static string FormatMoney(decimal amount) => AppFormat.Money(amount);
}
