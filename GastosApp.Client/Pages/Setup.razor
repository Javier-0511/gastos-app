@page "/setup"
@using GastosApp.Client.Services
@inject AuthService Auth
@inject AccountService Accounts
@inject NavigationManager Nav

<PageTitle>Configuración inicial</PageTitle>

<div class="container stagger" style="max-width: 500px; margin-top: 60px;">
    @if (isLoading)
    {
        <p>Cargando...</p>
    }
    else
    {
        <h2>¡Bienvenido!</h2>
        <p>Vamos a crear tus dos cuentas para empezar. Puedes cambiar los nombres si quieres.</p>

        @if (!hasPersonal)
        {
            <div class="mb-3">
                <label class="form-label">Cuenta personal</label>
                <input class="form-control" @bind="personalName" @bind:event="oninput" />
                <small class="text-muted">Para gastos que pagas con tu tarjeta personal.</small>
            </div>
        }

        @if (!hasShared)
        {
            <div class="mb-3">
                <label class="form-label">Cuenta compartida</label>
                <input class="form-control" @bind="sharedName" @bind:event="oninput" />
                <small class="text-muted">Para gastos pagados con la tarjeta compartida (50/50 con Marta).</small>
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <button class="btn btn-primary w-100" @onclick="HandleCreate" disabled="@(!IsValid)">
            Crear mis cuentas
        </button>
    }
</div>

@code {
    private string personalName = "Personal";
    private string sharedName = "Compartida";
    private string errorMessage = "";
    private bool isLoading = true;

    private bool hasPersonal = false;
    private bool hasShared = false;

    private bool IsValid =>
        (hasPersonal || !string.IsNullOrWhiteSpace(personalName)) &&
        (hasShared   || !string.IsNullOrWhiteSpace(sharedName));

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn)
        {
            Nav.NavigateTo("login");
            return;
        }

        var existing = await Accounts.GetMyAccountsAsync();
        if (existing.Count >= 2)
        {
            Nav.NavigateTo("");
            return;
        }

        hasPersonal = existing.Any(a => !a.IsShared);
        hasShared = existing.Any(a => a.IsShared);

        isLoading = false;
    }

    private async Task HandleCreate()
    {
        errorMessage = "";
        isLoading = true;

        try
        {
            if (!hasPersonal)
                await Accounts.CreateAccountAsync(personalName.Trim(), isShared: false);
            if (!hasShared)
                await Accounts.CreateAccountAsync(sharedName.Trim(), isShared: true);
            Nav.NavigateTo("");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al crear las cuentas: {ex.Message}";
            isLoading = false;
        }
    }
}
