@page "/setup"
@using GastosApp.Client.Services
@inject AuthService Auth
@inject AccountService Accounts
@inject NavigationManager Nav

<PageTitle>Configuración inicial</PageTitle>

<div class="setup-wrap stagger">
    @if (isLoading)
    {
        <p>Cargando...</p>
    }
    else
    {
        <div class="setup-logo">
            <img src="icon.svg" alt="" />
        </div>
        <h2 class="setup-title">¡Bienvenido!</h2>
        <p class="text-muted">Vamos a crear tus dos cuentas para empezar. Puedes cambiar los nombres si quieres.</p>

        <div class="surface-card setup-card">
            @if (!hasPersonal)
            {
                <div class="mb-3">
                    <label class="form-label">Cuenta personal</label>
                    <input class="form-control" @bind="personalName" @bind:event="oninput" />
                    <small class="text-muted">Para gastos que pagas con tu tarjeta personal.</small>
                </div>
            }

            @if (!hasShared)
            {
                <div class="mb-3">
                    <label class="form-label">Cuenta compartida</label>
                    <input class="form-control" @bind="sharedName" @bind:event="oninput" />
                    <small class="text-muted">Para gastos pagados con la tarjeta compartida (50/50 con Marta).</small>
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <button class="btn btn-primary btn-lg w-100" @onclick="HandleCreate" disabled="@(!IsValid)">
                Crear mis cuentas
            </button>
        </div>
    }
</div>

<style>
    .setup-wrap {
        max-width: 460px;
        margin: 0 auto;
        padding-top: 24px;
        text-align: center;
    }
    .setup-logo img {
        width: 72px;
        height: 72px;
        filter: drop-shadow(0 8px 22px var(--accent-glow));
        margin-bottom: 10px;
    }
    .setup-title {
        font-weight: 800;
        letter-spacing: -0.02em;
        margin: 0 0 6px;
    }
    .setup-card {
        padding: 22px;
        margin-top: 20px;
        text-align: left;
    }
</style>

@code {
    private string personalName = "Personal";
    private string sharedName = "Compartida";
    private string errorMessage = "";
    private bool isLoading = true;

    private bool hasPersonal = false;
    private bool hasShared = false;

    private bool IsValid =>
        (hasPersonal || !string.IsNullOrWhiteSpace(personalName)) &&
        (hasShared   || !string.IsNullOrWhiteSpace(sharedName));

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn)
        {
            Nav.NavigateTo("login");
            return;
        }

        var existing = await Accounts.GetMyAccountsAsync();
        if (existing.Count >= 2)
        {
            Nav.NavigateTo("");
            return;
        }

        hasPersonal = existing.Any(a => !a.IsShared);
        hasShared = existing.Any(a => a.IsShared);

        isLoading = false;
    }

    private async Task HandleCreate()
    {
        errorMessage = "";
        isLoading = true;

        try
        {
            if (!hasPersonal)
                await Accounts.CreateAccountAsync(personalName.Trim(), isShared: false);
            if (!hasShared)
                await Accounts.CreateAccountAsync(sharedName.Trim(), isShared: true);
            Nav.NavigateTo("");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al crear las cuentas: {ex.Message}";
            isLoading = false;
        }
    }
}
