@page "/dashboard"
@using System.Globalization
@using ApexCharts
@using GastosApp.Client.Models
@using GastosApp.Client.Services
@inject AuthService Auth
@inject AccountService Accounts
@inject CategoryService CategorySvc
@inject ExpenseService Expenses
@inject BudgetService Budgets
@inject NavigationManager Nav

<PageTitle>Dashboard</PageTitle>

@if (isLoading)
{
    <p>Cargando...</p>
}
else if (accounts.Count == 0)
{
    <p>No tienes cuentas. <a href="setup">Configura tus cuentas</a>.</p>
}
else
{
    <div class="container-narrow stagger">
        <h2 class="mb-3">Dashboard</h2>

        @* Pestañas de cuenta *@
        <AccountTabs Accounts="accounts"
                     SelectedAccountId="selectedAccountId"
                     OnAccountSelected="SelectAccount" />

        @* Donut: gasto por bloque sobre el dinero disponible del mes *@
        <div class="chart-card mb-3">
            <h6 class="chart-title">Reparto del mes — @MonthLabel</h6>

            @* Resumen: gastado, disponible y lo que queda *@
            @if (disponibleTotal is decimal disp)
            {
                <div class="budget-summary">
                    <span class="bs-spent">@FormatMoney(currentMonthTotal)</span>
                    <span class="bs-of">de @FormatMoney(disp) disponibles</span>
                    @if (Restante >= 0m)
                    {
                        <span class="bs-left positive">Te quedan @FormatMoney(Restante)</span>
                    }
                    else
                    {
                        <span class="bs-left negative">Te has pasado @FormatMoney(-Restante)</span>
                    }
                </div>
            }
            else
            {
                <p class="text-muted small mb-2">
                    Define tu <strong>saldo inicial</strong> en la vista de mes para ver cuánto te queda disponible.
                </p>
            }

            @* Comparación con el mes anterior *@
            <p class="month-compare @DiffClass">
                @if (previousMonthTotal == 0m)
                {
                    <span>Sin datos del mes anterior</span>
                }
                else
                {
                    <span>@DiffArrow @FormatMoney(Math.Abs(currentMonthTotal - previousMonthTotal)) vs mes anterior</span>
                }
            </p>

            @if (donutSlices.Count == 0)
            {
                <p class="text-muted small mb-0">No hay gastos este mes para repartir.</p>
            }
            else
            {
                <ApexChart TItem="BlockBucket"
                           @key="@($"pie-{selectedAccountId}")"
                           Options="pieOptions"
                           OnDataPointSelection="OnBlockSliceSelected">
                    <ApexPointSeries TItem="BlockBucket"
                                     Items="donutSlices"
                                     Name="Gasto"
                                     SeriesType="SeriesType.Donut"
                                     XValue='b => b.Label'
                                     YValue="b => b.Total" />
                </ApexChart>

                @* Leyenda clicable: cada color es un bloque con gasto *@
                <div class="block-legend">
                    @foreach (var b in blockBreakdown)
                    {
                        <button type="button"
                                class="legend-item @(selectedBlockKey == b.Key ? "active" : "")"
                                @onclick="() => ToggleBlock(b.Key)">
                            <span class="legend-dot" style="background:@b.Color"></span>
                            <span class="legend-label">@b.Label</span>
                            <span class="legend-total">@FormatMoney(b.Total)</span>
                        </button>
                    }
                </div>

                @* Recuadro con las categorías del bloque seleccionado *@
                @if (SelectedBlock is BlockBucket sel)
                {
                    <div class="block-detail" style="border-color:@sel.Color">
                        <div class="block-detail-head">
                            <span class="legend-dot" style="background:@sel.Color"></span>
                            <span class="block-detail-title">@sel.Label</span>
                            <span class="block-detail-total">@FormatMoney(sel.Total)</span>
                        </div>
                        <ul class="list-unstyled mb-0">
                            @foreach (var c in sel.Categories)
                            {
                                <li class="cat-row">
                                    <div class="cat-row-top">
                                        <span class="cat-name">@c.Name</span>
                                        <span class="cat-total">@FormatMoney(c.Total)</span>
                                    </div>
                                    <span class="cat-bar-wrap">
                                        <span class="cat-bar"
                                              style="width:@Pct(c.Total, sel.Total)%; background:@sel.Color"></span>
                                    </span>
                                </li>
                            }
                        </ul>
                    </div>
                }
                else if (blockBreakdown.Count > 0)
                {
                    <p class="text-muted small mb-0 mt-2">Toca un bloque para ver sus categorías.</p>
                }
            }
        </div>

        @* Evolución últimos 6 meses *@
        <div class="chart-card mb-3">
            <h6 class="chart-title">Evolución últimos 6 meses</h6>
            @if (last6Months.All(m => m.Total == 0m))
            {
                <p class="text-muted small mb-0">No hay gastos en los últimos 6 meses.</p>
            }
            else
            {
                <ApexChart TItem="MonthBucket"
                           @key="@($"evolution-{selectedAccountId}")"
                           Options="evolutionOptions">
                    <ApexPointSeries TItem="MonthBucket"
                                     Items="last6Months"
                                     Name="Gastado"
                                     SeriesType="SeriesType.Bar"
                                     XValue='m => m.Label'
                                     YValue="m => m.Total" />
                </ApexChart>
            }
        </div>
    </div>
}

<style>
    .container-narrow {
        max-width: 700px;
        margin: 0 auto;
        padding: 16px;
    }

    /* Comparación con el mes anterior (línea bajo el resumen del rosco) */
    .month-compare {
        font-size: 0.8rem;
        margin: 0 0 10px;
    }

    .month-compare.up   { color: #ef4444; }   /* gastas más = peor */
    .month-compare.down { color: #10b981; }   /* gastas menos = mejor */
    .month-compare.flat { color: #6c757d; }

    .chart-card {
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 16px 18px;
    }

    .chart-title {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #6c757d;
        margin: 0 0 8px;
    }

    /* === Resumen gastado / disponible / restante === */
    .budget-summary {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 4px 8px;
        margin-bottom: 12px;
    }

    .budget-summary .bs-spent {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1e1b4b;
    }

    .budget-summary .bs-of {
        color: #6c757d;
        font-size: 0.9rem;
    }

    .budget-summary .bs-left {
        margin-left: auto;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .budget-summary .bs-left.positive { color: #10b981; }
    .budget-summary .bs-left.negative { color: #ef4444; }

    /* === Leyenda clicable de bloques === */
    .block-legend {
        display: flex;
        flex-direction: column;
        gap: 4px;
        margin-top: 8px;
    }

    .legend-item {
        display: grid;
        grid-template-columns: 16px 1fr auto;
        gap: 10px;
        align-items: center;
        width: 100%;
        padding: 8px 10px;
        border: 1px solid transparent;
        border-radius: 8px;
        background: transparent;
        text-align: left;
        cursor: pointer;
        transition: background 0.15s ease, border-color 0.15s ease;
    }

    .legend-item:hover { background: #f1f3f5; }
    .legend-item.active {
        background: #f8f9fa;
        border-color: #dee2e6;
    }

    .legend-dot {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        display: inline-block;
    }

    .legend-label { font-weight: 500; }
    .legend-total { font-weight: 600; }

    /* === Recuadro de categorías del bloque === */
    .block-detail {
        margin-top: 10px;
        border: 1px solid #dee2e6;
        border-left-width: 4px;
        border-radius: 8px;
        padding: 12px 14px;
        background: #fcfcfd;
    }

    .block-detail-head {
        display: grid;
        grid-template-columns: 16px 1fr auto;
        gap: 10px;
        align-items: center;
        margin-bottom: 10px;
    }

    .block-detail-title { font-weight: 600; }
    .block-detail-total { font-weight: 700; }

    /* Cada categoría en dos líneas: nombre + importe arriba, barra a lo ancho
       debajo. Encaja bien en móvil y evita que el nombre se corte. */
    .cat-row {
        padding: 7px 0;
    }

    .cat-row-top {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 10px;
        margin-bottom: 5px;
    }

    .cat-name {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .cat-bar-wrap {
        display: block;
        width: 100%;
        background: #edf0f2;
        border-radius: 6px;
        height: 8px;
        overflow: hidden;
    }

    .cat-bar {
        display: block;
        height: 100%;
        border-radius: 6px;
        min-width: 2px;
    }

    .cat-total { font-weight: 500; font-size: 0.9rem; }
</style>

@code {
    private bool isLoading = true;

    private List<Account> accounts = new();
    private Dictionary<Guid, Category> categoryMap = new();

    private Guid selectedAccountId;
    private int currentYear;
    private int currentMonth;

    private decimal currentMonthTotal = 0m;
    private decimal previousMonthTotal = 0m;

    private List<MonthBucket> last6Months = new();
    private List<BlockBucket> blockBreakdown = new();

    // Presupuesto del mes para la cuenta activa (saldo inicial, aporte/nómina).
    private MonthlyBudget? currentBudget;

    // Dinero disponible este mes = saldo inicial + lo que entra.
    // null = no se puede calcular (aún no hay saldo inicial definido).
    private decimal? disponibleTotal;

    // Porciones que se dibujan en el donut: los bloques con gasto + un trozo
    // gris "Disponible" con lo que queda. Se separa de blockBreakdown para que
    // la leyenda y el detalle por categorías sigan mostrando solo los bloques.
    private List<BlockBucket> donutSlices = new();

    // Lo que queda por gastar (puede ser negativo si te has pasado).
    private decimal Restante => (disponibleTotal ?? 0m) - currentMonthTotal;

    // Bloque cuyo recuadro de categorías está abierto (null = ninguno).
    private string? selectedBlockKey;

    private BlockBucket? SelectedBlock =>
        blockBreakdown.FirstOrDefault(b => b.Key == selectedBlockKey);

    private ApexChartOptions<MonthBucket> evolutionOptions = new()
    {
        Chart = new Chart
        {
            Toolbar = new Toolbar { Show = false },
            FontFamily = "Helvetica Neue, Helvetica, Arial, sans-serif"
        },
        Colors = new List<string> { "#6366f1" },
        PlotOptions = new PlotOptions
        {
            Bar = new PlotOptionsBar { BorderRadius = 6, ColumnWidth = "55%" }
        },
        DataLabels = new DataLabels { Enabled = false },
        Grid = new Grid { BorderColor = "#e9ecef" },
        Yaxis = new List<YAxis>
        {
            new YAxis { Labels = new YAxisLabels { Formatter = "function (v) { return v.toLocaleString('es-ES') + ' €'; }" } }
        }
    };

    // La leyenda nativa de ApexCharts va oculta: renderizamos nuestra propia
    // leyenda clicable debajo (los colores se asignan por bloque en LoadData).
    private ApexChartOptions<BlockBucket> pieOptions = new()
    {
        Chart = new Chart
        {
            Height = 240,
            FontFamily = "Helvetica Neue, Helvetica, Arial, sans-serif"
        },
        Legend = new Legend { Show = false },
        DataLabels = new DataLabels
        {
            Enabled = true,
            Formatter = "function (val) { return val.toFixed(0) + '%'; }"
        }
    };

    // Cultura tomada del helper global AppFormat.Es
    private static CultureInfo Es => AppFormat.Es;

    private string MonthLabel
    {
        get
        {
            var date = new DateTime(currentYear, currentMonth, 1);
            var raw = date.ToString("MMMM yyyy", Es);
            return char.ToUpper(raw[0]) + raw[1..];
        }
    }

    private string DiffArrow
    {
        get
        {
            if (currentMonthTotal > previousMonthTotal) return "↑";
            if (currentMonthTotal < previousMonthTotal) return "↓";
            return "•";
        }
    }

    private string DiffClass
    {
        get
        {
            if (previousMonthTotal == 0) return "flat";
            if (currentMonthTotal > previousMonthTotal) return "up";
            if (currentMonthTotal < previousMonthTotal) return "down";
            return "flat";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn)
        {
            Nav.NavigateTo("login");
            return;
        }

        var today = DateTime.Today;
        currentYear = today.Year;
        currentMonth = today.Month;

        accounts = (await Accounts.GetMyAccountsAsync())
            .OrderBy(a => a.IsShared)
            .ToList();

        if (accounts.Count == 0)
        {
            isLoading = false;
            return;
        }

        selectedAccountId = accounts.First().Id;

        await LoadCategories();
        await LoadData();

        isLoading = false;
    }

    private async Task LoadCategories()
    {
        categoryMap.Clear();
        var cats = await CategorySvc.GetByAccountsAsync(accounts.Select(a => a.Id));
        foreach (var c in cats)
            categoryMap[c.Id] = c;
    }

    private async Task LoadData()
    {
        // Rango: 6 meses hacia atrás contando el actual.
        var firstOfCurrentMonth = new DateTime(currentYear, currentMonth, 1);
        var rangeStart = firstOfCurrentMonth.AddMonths(-5);
        var rangeEnd = firstOfCurrentMonth.AddMonths(1);

        // Una sola query para los 6 meses; filtramos en memoria.
        var allExpenses = (await Expenses.GetByDateRangeAsync(rangeStart, rangeEnd))
            .Where(e => e.AccountId == selectedAccountId)
            .ToList();

        // === Evolución últimos 6 meses ===
        last6Months = new();
        for (int i = 0; i < 6; i++)
        {
            var monthStart = rangeStart.AddMonths(i);
            var monthEnd = monthStart.AddMonths(1);
            var total = allExpenses
                .Where(e => e.ExpenseDate >= monthStart && e.ExpenseDate < monthEnd)
                .Sum(e => e.Amount);
            last6Months.Add(new MonthBucket(monthStart, total));
        }

        // === KPI: mes actual y anterior ===
        var prevMonthStart = firstOfCurrentMonth.AddMonths(-1);
        currentMonthTotal = allExpenses
            .Where(e => e.ExpenseDate >= firstOfCurrentMonth && e.ExpenseDate < rangeEnd)
            .Sum(e => e.Amount);
        previousMonthTotal = allExpenses
            .Where(e => e.ExpenseDate >= prevMonthStart && e.ExpenseDate < firstOfCurrentMonth)
            .Sum(e => e.Amount);

        // === Reparto por bloque del mes actual ===
        // Agrupamos primero por bloque (Fijos, Comida...) y, dentro de cada
        // bloque, por categoría, para poder desplegar el detalle al hacer clic.
        var currentMonthExpenses = allExpenses
            .Where(e => e.ExpenseDate >= firstOfCurrentMonth && e.ExpenseDate < rangeEnd)
            .ToList();

        blockBreakdown = currentMonthExpenses
            .GroupBy(e => CategoryBlockKey(e.CategoryId))
            .Select(g => new BlockBucket(
                g.Key,
                Blocks.Label(g.Key),
                g.Sum(e => e.Amount),
                BlockColor(g.Key),
                g.GroupBy(e => e.CategoryId)
                    .Select(cg => new CategoryBucket(CategoryName(cg.Key), cg.Sum(e => e.Amount)))
                    .OrderByDescending(c => c.Total)
                    .ToList()))
            .OrderBy(b => Blocks.Order(b.Key))
            .ToList();

        // === Dinero disponible del mes (total del rosco) ===
        // Leemos el presupuesto de la cuenta-mes (saldo inicial + aporte/nómina).
        currentBudget = await Budgets.GetForMonthAsync(selectedAccountId, currentYear, currentMonth);
        var account = accounts.First(a => a.Id == selectedAccountId);

        // En la cuenta personal parte del dinero se va como aporte a la compartida,
        // así que hay que restarlo. El aporte = mi parte (50%) del aporte conjunto
        // de la compartida ese mes. Para la compartida este valor no se usa.
        decimal aporteACompartida = 0m;
        if (!account.IsShared)
        {
            var sharedAccount = accounts.FirstOrDefault(a => a.IsShared);
            if (sharedAccount is not null)
            {
                var sharedBudget = await Budgets.GetForMonthAsync(sharedAccount.Id, currentYear, currentMonth);
                aporteACompartida = SaldoCalculator.AporteACompartida(
                    sharedBudget?.Amount ?? 0m, MyShareInShared);
            }
        }

        disponibleTotal = ComputeDisponible(account, currentBudget, aporteACompartida);

        // El donut parte de los bloques con gasto y, si hay disponible de sobra,
        // le añadimos una porción gris "Disponible" con lo que queda.
        donutSlices = new List<BlockBucket>(blockBreakdown);
        if (Restante > 0m)
        {
            donutSlices.Add(new BlockBucket(
                DisponibleKey, "Disponible", Restante, DisponibleColor, new List<CategoryBucket>()));
        }

        // Los colores del donut se toman de cada porción, en el mismo orden que
        // las porciones, para que coincidan con la leyenda y el recuadro.
        pieOptions.Colors = donutSlices.Select(b => b.Color).ToList();

        // Si el bloque que estaba abierto ya no tiene gastos, cerramos el recuadro.
        if (selectedBlockKey is not null && SelectedBlock is null)
            selectedBlockKey = null;
    }

    // Clave y color de la porción gris "Disponible" del donut.
    private const string DisponibleKey = "(disponible)";
    private const string DisponibleColor = "#e5e7eb";

    // TODO: cuando entre Marta y queramos share_percent dinámico, leerlo de
    // account_members. Por ahora mi parte en la cuenta compartida es 50%.
    private const decimal MyShareInShared = 0.5m;

    // Dinero disponible del mes = lo que te queda para gastar antes de gastar.
    // - Compartida: saldo inicial + aporte conjunto.
    // - Personal:  saldo inicial + nómina − aporte a la compartida.
    // Así el hueco gris (disponible − gastos) coincide con el saldo final.
    // Devuelve null si aún no hay saldo inicial definido (no se puede calcular).
    private static decimal? ComputeDisponible(Account account, MonthlyBudget? budget, decimal aporteACompartida)
    {
        if (budget?.OpeningBalance is not decimal opening) return null;
        return account.IsShared
            ? opening + budget.Amount
            : opening + (budget.Income ?? 0m) - aporteACompartida;
    }

    private string CategoryName(Guid? id) =>
        id is Guid g && categoryMap.TryGetValue(g, out var c) ? c.Name : "(sin categoría)";

    // Clave de bloque de un gasto a partir de su categoría. Si la categoría no
    // existe o no tiene bloque, lo agrupamos bajo un bloque "sin bloque".
    private const string NoBlockKey = "(sin bloque)";

    private string CategoryBlockKey(Guid? id) =>
        id is Guid g && categoryMap.TryGetValue(g, out var c) && !string.IsNullOrEmpty(c.Block)
            ? c.Block
            : NoBlockKey;

    // Color fijo por bloque, para que la porción del donut, el puntito de la
    // leyenda y el borde del recuadro sean siempre del mismo color.
    private static readonly Dictionary<string, string> BlockColors = new()
    {
        ["fijo"]       = "#6366f1",
        ["comida"]     = "#10b981",
        ["variable"]   = "#f97316",
        ["minicompra"] = "#ec4899",
        ["ocio"]       = "#8b5cf6",
        ["inversion"]  = "#06b6d4",
        ["individual"] = "#eab308",
    };

    private static string BlockColor(string key) =>
        BlockColors.TryGetValue(key, out var c) ? c : "#94a3b8";

    // Porcentaje (0-100) de una categoría dentro del total del bloque, para la barrita.
    private static int Pct(decimal part, decimal whole) =>
        whole <= 0 ? 0 : (int)Math.Round(part / whole * 100);

    // Abre/cierra el recuadro de un bloque desde la leyenda.
    private void ToggleBlock(string key) =>
        selectedBlockKey = selectedBlockKey == key ? null : key;

    // Clic directo en una porción del donut: abre el recuadro de ese bloque.
    private void OnBlockSliceSelected(SelectedData<BlockBucket> data)
    {
        var idx = data.DataPointIndex;
        if (idx >= 0 && idx < blockBreakdown.Count)
            selectedBlockKey = blockBreakdown[idx].Key;
    }

    private async Task SelectAccount(Guid accountId)
    {
        if (accountId == selectedAccountId) return;

        // Reseteamos los datos a vacíos y forzamos un render intermedio.
        // Así ApexCharts se destruye con series vacías antes de recargar,
        // evitando residuos visuales (etiquetas como "series-3" mezcladas
        // entre el render anterior y el nuevo).
        selectedAccountId = accountId;
        last6Months = new();
        blockBreakdown = new();
        donutSlices = new();
        disponibleTotal = null;
        currentBudget = null;
        selectedBlockKey = null;
        currentMonthTotal = 0m;
        previousMonthTotal = 0m;
        StateHasChanged();
        await Task.Yield();

        await LoadData();
    }

    private static string FormatMoney(decimal amount) => AppFormat.Money(amount);

    /// <summary>DTO local para el gráfico de evolución mensual.</summary>
    public record MonthBucket(DateTime Month, decimal Total)
    {
        public string Label
        {
            get
            {
                var raw = Month.ToString("MMM", Es);
                return char.ToUpper(raw[0]) + raw[1..].TrimEnd('.');
            }
        }
    }

    /// <summary>Gasto de una categoría dentro de un bloque.</summary>
    public record CategoryBucket(string Name, decimal Total);

    /// <summary>
    /// Un bloque del reparto: total del bloque, su color y el desglose por
    /// categoría que se muestra en el recuadro al hacer clic.
    /// </summary>
    public record BlockBucket(
        string Key,
        string Label,
        decimal Total,
        string Color,
        List<CategoryBucket> Categories);
}
