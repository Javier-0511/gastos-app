@page "/mes"
@using System.Globalization
@* FormatMoney y CultureInfo("es-ES") viven ahora en AppFormat (Helpers/AppFormat.cs) *@
@using GastosApp.Client.Models
@using GastosApp.Client.Services
@inject AuthService Auth
@inject AccountService Accounts
@inject CategoryService CategorySvc
@inject ExpenseService Expenses
@inject BudgetService Budgets
@inject NavigationManager Nav

<PageTitle>Vista del mes</PageTitle>

@if (isLoading)
{
    <p>Cargando...</p>
}
else if (accounts.Count == 0)
{
    <p>No tienes cuentas. <a href="setup">Configura tus cuentas</a>.</p>
}
else
{
    <div class="container-narrow stagger">

        @* Selector de mes *@
        <div class="month-nav">
            <button class="btn nav-btn" @onclick="PreviousMonth" aria-label="Mes anterior">◀</button>
            <h4 class="m-0 text-capitalize">@MonthLabel</h4>
            <button class="btn nav-btn" @onclick="NextMonth" aria-label="Mes siguiente">▶</button>
        </div>

        @* Botón añadir gasto rápido (preselecciona la cuenta activa) *@
        <a class="btn btn-primary w-100 mb-3"
           href="@($"nuevo-gasto?accountId={selectedAccountId}")">
            + Añadir gasto
        </a>

        @* Pestañas de cuenta *@
        <AccountTabs Accounts="accounts"
                     SelectedAccountId="selectedAccountId"
                     OnAccountSelected="SelectAccount" />

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        @* Bloque de saldos: una variante por tipo de cuenta *@
        <div class="balance-card mb-3">
            @if (IsCurrentAccountShared)
            {
                @* === COMPARTIDA: saldo inicial + aporte conjunto - gastos = saldo final === *@
                <div class="balance-row">
                    <span class="balance-label">Saldo inicial</span>
                    <span class="balance-value">
                        @(currentBudget?.OpeningBalance is decimal ob1
                            ? FormatMoney(ob1)
                            : SinDefinir())
                    </span>
                    <button class="btn btn-sm btn-outline-secondary"
                            @onclick="OpenOpeningBalanceModal">
                        @(currentBudget?.OpeningBalance is null ? "Establecer" : "Editar")
                    </button>
                </div>

                <div class="balance-row">
                    <span class="balance-label">Aporte conjunto</span>
                    <span class="balance-value">
                        @(currentBudget is null
                            ? SinDefinir()
                            : FormatMoney(currentBudget.Amount))
                    </span>
                    <button class="btn btn-sm btn-outline-secondary"
                            @onclick="OpenAmountModal">
                        @(currentBudget is null ? "Establecer" : "Editar")
                    </button>
                </div>

                <div class="balance-row">
                    <span class="balance-label">Gastos del mes</span>
                    <span class="balance-value negative">−@FormatMoney(currentTotal)</span>
                </div>

                <hr class="my-2"/>

                <div class="balance-row balance-final">
                    <span class="balance-label fw-bold">Saldo final</span>
                    <span class="balance-value money @(SaldoFinal() < 0 ? "negative" : "positive")">
                        @(SaldoFinal() is decimal sf1 ? FormatMoney(sf1) : "—")
                    </span>
                </div>

                <div class="balance-row balance-restante">
                    <span class="balance-label">Restante del aporte</span>
                    <span class="balance-value money @(Restante() < 0 ? "negative" : "positive")">
                        @(Restante() is decimal re1 ? FormatMoney(re1) : "—")
                    </span>
                </div>
            }
            else
            {
                @* === PERSONAL: saldo inicial + nómina - aporte_compartida - gastos = saldo final === *@
                <div class="balance-row">
                    <span class="balance-label">Saldo inicial</span>
                    <span class="balance-value">
                        @(currentBudget?.OpeningBalance is decimal ob2
                            ? FormatMoney(ob2)
                            : SinDefinir())
                    </span>
                    <button class="btn btn-sm btn-outline-secondary"
                            @onclick="OpenOpeningBalanceModal">
                        @(currentBudget?.OpeningBalance is null ? "Establecer" : "Editar")
                    </button>
                </div>

                <div class="balance-row">
                    <span class="balance-label">Nómina</span>
                    <span class="balance-value">
                        @(currentBudget?.Income is decimal inc
                            ? FormatMoney(inc)
                            : SinDefinir())
                    </span>
                    <button class="btn btn-sm btn-outline-secondary"
                            @onclick="OpenIncomeModal">
                        @(currentBudget?.Income is null ? "Establecer" : "Editar")
                    </button>
                </div>

                <div class="balance-row">
                    <span class="balance-label">
                        Aporte a compartida
                        <small class="text-muted">(50% de @FormatMoney(sharedAmount))</small>
                    </span>
                    <span class="balance-value negative">−@FormatMoney(AporteACompartida())</span>
                </div>

                <div class="balance-row">
                    <span class="balance-label">Gastos personales</span>
                    <span class="balance-value negative">−@FormatMoney(currentTotal)</span>
                </div>

                <hr class="my-2"/>

                <div class="balance-row balance-final">
                    <span class="balance-label fw-bold">Saldo final</span>
                    <span class="balance-value money @(SaldoFinal() < 0 ? "negative" : "positive")">
                        @(SaldoFinal() is decimal sf2 ? FormatMoney(sf2) : "—")
                    </span>
                </div>

                <div class="balance-row balance-restante">
                    <span class="balance-label">Restante de nómina</span>
                    <span class="balance-value money @(Restante() < 0 ? "negative" : "positive")">
                        @(Restante() is decimal re2 ? FormatMoney(re2) : "—")
                    </span>
                </div>
            }
        </div>

        @* Bloques de categorías agrupados *@
        @if (currentExpenses.Count == 0)
        {
            <p class="text-muted text-center my-4">No hay gastos en esta cuenta este mes.</p>
        }
        else
        {
            @foreach (var blockKey in BlocksToShow())
            {
                var blockExpenses = currentExpenses
                    .Where(e => CategoryOf(e.CategoryId)?.Block == blockKey)
                    .ToList();

                var blockTotal = blockExpenses.Sum(e => e.Amount);
                var isExpanded = expandedBlocks.Contains(blockKey);

                <div class="block-card mb-2">
                    <button class="block-header" @onclick="() => ToggleBlock(blockKey)">
                        <span class="block-arrow @(isExpanded ? "expanded" : "")">▸</span>
                        <span class="block-name">@BlockLabel(blockKey)</span>
                        <span class="block-count text-muted">@blockExpenses.Count</span>
                        <span class="block-total">@FormatMoney(blockTotal)</span>
                    </button>

                    @* Wrapper siempre presente. La animación va por CSS:
                       grid-template-rows 0fr → 1fr cuando .expanded *@
                    <div class="block-content-wrap @(isExpanded ? "expanded" : "")">
                        <div class="block-content">
                            @if (blockExpenses.Count == 0)
                            {
                                <div class="block-empty text-muted small">Sin gastos en este bloque.</div>
                            }
                            else
                            {
                                <ul class="list-unstyled mb-0">
                                    @foreach (var exp in blockExpenses.OrderByDescending(e => e.ExpenseDate))
                                    {
                                        <li class="expense-row">
                                            <div class="expense-main">
                                                <div class="expense-title">
                                                    @(string.IsNullOrWhiteSpace(exp.Description)
                                                        ? CategoryOf(exp.CategoryId)?.Name ?? "(sin categoría)"
                                                        : exp.Description)
                                                </div>
                                                <div class="expense-meta text-muted small">
                                                    @exp.ExpenseDate.ToString("dd MMM", AppFormat.Es)
                                                    @* La categoría solo se repite aquí cuando el título es la descripción;
                                                       si no hay descripción, el título ya es la categoría. *@
                                                    @if (!string.IsNullOrWhiteSpace(exp.Description))
                                                    {
                                                        <text> · @(CategoryOf(exp.CategoryId)?.Name ?? "—")</text>
                                                    }
                                                </div>
                                            </div>
                                            <div class="expense-amount">@FormatMoney(exp.Amount)</div>
                                            <div class="expense-actions">
                                                <a class="icon-btn"
                                                   href="@($"nuevo-gasto?id={exp.Id}")"
                                                   title="Editar" aria-label="Editar gasto">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                                        <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
                                                    </svg>
                                                </a>
                                                <button class="icon-btn icon-btn-danger"
                                                        @onclick="() => HandleDelete(exp)"
                                                        title="Borrar" aria-label="Borrar gasto">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                                        <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                                    </svg>
                                                </button>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
}

@* Modal de borrado de gasto *@
<ConfirmModal @ref="confirmModal"
              Title="Borrar gasto"
              Message="Esta acción no se puede deshacer."
              ConfirmText="Borrar"
              ConfirmClass="btn-danger" />

@* Modal genérico para editar un campo numérico (saldo / nómina / aporte) *@
@if (numberModalVisible)
{
    <div class="modal-backdrop-custom" @onclick="CloseNumberModal">
        <div class="modal-card" @onclick:stopPropagation="true">
            <h5 class="mb-2">@numberModalTitle</h5>
            @if (!string.IsNullOrEmpty(numberModalHint))
            {
                <p class="text-muted small mb-3">@numberModalHint</p>
            }

            <div class="input-group input-group-lg mb-3">
                <input type="number"
                       inputmode="decimal"
                       step="0.01"
                       class="form-control"
                       placeholder="0,00"
                       @bind="numberInput"
                       @bind:event="oninput" />
                <span class="input-group-text">€</span>
            </div>

            @if (!string.IsNullOrEmpty(numberModalError))
            {
                <div class="alert alert-danger small">@numberModalError</div>
            }

            <div class="d-flex gap-2 justify-content-end">
                <button class="btn btn-outline-secondary"
                        @onclick="CloseNumberModal"
                        disabled="@isSavingNumber">
                    Cancelar
                </button>
                <button class="btn btn-primary"
                        @onclick="SaveNumberModal"
                        disabled="@(isSavingNumber || numberInput is null)">
                    @(isSavingNumber ? "Guardando..." : "Guardar")
                </button>
            </div>
        </div>
    </div>
}

<style>
    .container-narrow {
        max-width: 600px;
        margin: 0 auto;
    }

    /* Cabecera de mes: botones redondos a los lados */
    .month-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }
    .month-nav h4 {
        font-weight: 800;
        font-size: 1.2rem;
        letter-spacing: -0.01em;
    }
    .nav-btn {
        width: 42px;
        height: 42px;
        padding: 0;
        border: 1px solid var(--border-strong);
        background: var(--surface-1);
        color: var(--text-muted);
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    .nav-btn:hover { background: var(--surface-2); color: var(--text); }

    /* Tarjeta de saldos */
    .balance-card {
        background: var(--surface-1);
        border: 1px solid var(--border);
        border-radius: var(--r-md);
        box-shadow: var(--shadow-sm);
        padding: 18px 20px;
    }
    .balance-card hr {
        border-color: var(--border);
        opacity: 1;
    }

    .balance-row {
        display: grid;
        grid-template-columns: 1fr auto auto;
        gap: 12px;
        align-items: center;
        padding: 6px 0;
    }
    .balance-label { color: var(--text-muted); font-size: 0.92rem; }
    .balance-value {
        font-weight: 600;
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    /* Fila del saldo final, destacada */
    .balance-final .balance-label { color: var(--text); font-size: 1.02rem; }
    .balance-final .balance-value { font-size: 1.18rem; }

    /* Restante del ingreso: secundaria, separada con una línea fina */
    .balance-restante {
        margin-top: 4px;
        padding-top: 10px;
        border-top: 1px dashed var(--border);
    }

    /* Tarjetas de bloque (desplegables) */
    .block-card {
        border: 1px solid var(--border);
        border-radius: var(--r-md);
        overflow: hidden;
        background: var(--surface-1);
        margin-bottom: 10px;
    }

    .block-header {
        width: 100%;
        display: grid;
        grid-template-columns: 24px 1fr auto auto;
        gap: 10px;
        align-items: center;
        padding: 13px 16px;
        background: transparent;
        border: none;
        text-align: left;
        cursor: pointer;
        color: var(--text);
        transition: background 0.15s ease;
    }
    .block-header:hover { background: var(--surface-2); }

    .block-arrow {
        color: var(--text-dim);
        font-size: 0.9rem;
        transition: transform 0.2s ease-out;
        display: inline-block;
    }
    .block-arrow.expanded { transform: rotate(90deg); }

    /* Truco para animar height:auto → grid-template-rows interpola 0fr↔1fr. */
    .block-content-wrap {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.25s ease-out;
    }
    .block-content-wrap.expanded { grid-template-rows: 1fr; }
    .block-content { overflow: hidden; min-height: 0; }

    .block-name { font-weight: 700; }
    .block-count {
        background: var(--surface-3);
        color: var(--text-muted);
        border-radius: var(--r-pill);
        padding: 2px 9px;
        font-size: 0.78rem;
        font-weight: 600;
    }
    .block-total { font-weight: 700; font-variant-numeric: tabular-nums; }

    .block-empty { padding: 10px 16px; }

    .expense-row {
        display: grid;
        grid-template-columns: 1fr auto auto;
        gap: 12px;
        padding: 10px 16px;
        border-top: 1px solid var(--border);
        align-items: center;
    }

    .expense-main { min-width: 0; }
    .expense-title {
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .expense-meta { font-size: 0.8rem; color: var(--text-dim); }
    .expense-amount { font-weight: 700; font-variant-numeric: tabular-nums; }

    .expense-actions {
        display: flex;
        gap: 6px;
    }

    /* .modal-backdrop-custom y .modal-card viven en app.css (global) */
</style>

@code {
    // Cuenta a preseleccionar al entrar, p. ej. al volver de guardar un gasto
    // (?accountId={guid}). Si no viene o no existe, se usa la primera cuenta.
    [SupplyParameterFromQuery(Name = "accountId")]
    public Guid? PreselectedAccountId { get; set; }

    private bool isLoading = true;
    private string errorMessage = "";

    private List<Account> accounts = new();
    private Dictionary<Guid, Category> categoryMap = new();
    private List<Expense> currentExpenses = new();
    private MonthlyBudget? currentBudget;

    // Previsión de la cuenta compartida en el mes actual.
    // La necesitamos para calcular el aporte cuando la pestaña activa es personal.
    private MonthlyBudget? sharedBudgetThisMonth;

    private Guid selectedAccountId;
    private int currentYear;
    private int currentMonth;

    private HashSet<string> expandedBlocks = new();

    private ConfirmModal? confirmModal;

    // === Modal genérico de número ===
    private bool numberModalVisible = false;
    private bool isSavingNumber = false;
    private decimal? numberInput;
    private string numberModalTitle = "";
    private string numberModalHint = "";
    private string numberModalError = "";
    private bool numberModalAllowNegative = false;
    private Func<decimal, Task>? numberModalOnSave;

    // TODO: cuando entre Marta y queramos soportar share_percent dinámico,
    // leerlo de account_members del usuario en la cuenta compartida.
    // Por ahora siempre 50%.
    private const decimal MyShareInShared = 0.5m;

    private string MonthLabel
    {
        get
        {
            var date = new DateTime(currentYear, currentMonth, 1);
            return date.ToString("MMMM yyyy", AppFormat.Es);
        }
    }

    private decimal currentTotal => currentExpenses.Sum(e => e.Amount);

    private Account? CurrentAccount =>
        accounts.FirstOrDefault(a => a.Id == selectedAccountId);

    private bool IsCurrentAccountShared => CurrentAccount?.IsShared == true;

    private Account? SharedAccount => accounts.FirstOrDefault(a => a.IsShared);

    private decimal sharedAmount => sharedBudgetThisMonth?.Amount ?? 0m;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn)
        {
            Nav.NavigateTo("login");
            return;
        }

        var today = DateTime.Today;
        currentYear = today.Year;
        currentMonth = today.Month;

        accounts = (await Accounts.GetMyAccountsAsync())
            .OrderBy(a => a.IsShared)
            .ToList();

        if (accounts.Count == 0)
        {
            isLoading = false;
            return;
        }

        // Si la URL trae ?accountId={guid} y existe entre mis cuentas, lo usamos
        // (volver de guardar un gasto). Si no, primera cuenta (personal).
        var preselected = PreselectedAccountId.HasValue
            ? accounts.FirstOrDefault(a => a.Id == PreselectedAccountId.Value)
            : null;
        selectedAccountId = preselected?.Id ?? accounts.First().Id;

        await LoadAllCategories();
        await LoadMonthData();

        isLoading = false;
    }

    private async Task LoadAllCategories()
    {
        categoryMap.Clear();
        var cats = await CategorySvc.GetByAccountsAsync(accounts.Select(a => a.Id));
        foreach (var c in cats)
            categoryMap[c.Id] = c;
    }

    private async Task LoadMonthData()
    {
        await LoadExpenses();
        await LoadBudgets();
    }

    private async Task LoadExpenses()
    {
        try
        {
            errorMessage = "";
            var all = await Expenses.GetByMonthAsync(currentYear, currentMonth);
            currentExpenses = all
                .Where(e => e.AccountId == selectedAccountId)
                .ToList();
        }
        catch (Exception ex)
        {
            errorMessage = "No se pudieron cargar los gastos. Inténtalo de nuevo.";
            Console.Error.WriteLine(ex.ToString());
            currentExpenses = new();
        }
    }

    private async Task LoadBudgets()
    {
        try
        {
            currentBudget = await Budgets.GetForMonthAsync(selectedAccountId, currentYear, currentMonth);

            // Si la cuenta activa es personal, también cargamos la previsión de
            // la compartida para calcular el aporte. Si la activa ya es la
            // compartida, ese mismo budget también nos vale.
            if (IsCurrentAccountShared)
            {
                sharedBudgetThisMonth = currentBudget;
            }
            else if (SharedAccount is not null)
            {
                sharedBudgetThisMonth = await Budgets.GetForMonthAsync(
                    SharedAccount.Id, currentYear, currentMonth);
            }
            else
            {
                sharedBudgetThisMonth = null;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "No se pudo cargar la previsión. Inténtalo de nuevo.";
            Console.Error.WriteLine(ex.ToString());
            currentBudget = null;
            sharedBudgetThisMonth = null;
        }
    }

    private async Task SelectAccount(Guid accountId)
    {
        selectedAccountId = accountId;
        expandedBlocks.Clear();
        await LoadMonthData();
    }

    private async Task PreviousMonth()
    {
        var date = new DateTime(currentYear, currentMonth, 1).AddMonths(-1);
        currentYear = date.Year;
        currentMonth = date.Month;
        expandedBlocks.Clear();
        await LoadMonthData();
    }

    private async Task NextMonth()
    {
        var date = new DateTime(currentYear, currentMonth, 1).AddMonths(1);
        currentYear = date.Year;
        currentMonth = date.Month;
        expandedBlocks.Clear();
        await LoadMonthData();
    }

    private void ToggleBlock(string blockKey)
    {
        if (!expandedBlocks.Add(blockKey))
            expandedBlocks.Remove(blockKey);
    }

    private Category? CategoryOf(Guid? categoryId) =>
        categoryId is Guid id && categoryMap.TryGetValue(id, out var c) ? c : null;

    // Bloques estándar de la cuenta + cualquier bloque presente en los gastos
    // del mes (p. ej. categorías legacy en 'individual' aún sin reasignar),
    // para no ocultar ningún gasto. Ordenados.
    private IEnumerable<string> BlocksToShow()
    {
        var present = currentExpenses
            .Select(e => CategoryOf(e.CategoryId)?.Block)
            .Where(b => b is not null)
            .Cast<string>();

        return Blocks.For(IsCurrentAccountShared)
            .Concat(present)
            .Distinct()
            .OrderBy(Blocks.Order);
    }

    private async Task HandleDelete(Expense exp)
    {
        if (confirmModal is null) return;

        var confirmed = await confirmModal.ShowAsync();
        if (!confirmed) return;

        try
        {
            await Expenses.DeleteAsync(exp.Id);
            await LoadExpenses();
        }
        catch (Exception ex)
        {
            errorMessage = "No se pudo borrar el gasto. Inténtalo de nuevo.";
            Console.Error.WriteLine(ex.ToString());
        }
    }

    // ===== Cálculos derivados =====

    private decimal AporteACompartida()
    {
        if (IsCurrentAccountShared) return 0m;
        return SaldoCalculator.AporteACompartida(sharedAmount, MyShareInShared);
    }

    /// <summary>
    /// Saldo final del mes para la cuenta activa.
    /// Devuelve null si falta opening_balance (no se puede calcular).
    /// </summary>
    private decimal? SaldoFinal()
    {
        if (currentBudget?.OpeningBalance is not decimal opening) return null;

        if (IsCurrentAccountShared)
        {
            return SaldoCalculator.SaldoFinalCompartida(
                opening, currentBudget?.Amount ?? 0m, currentTotal);
        }
        else
        {
            return SaldoCalculator.SaldoFinalPersonal(
                opening, currentBudget?.Income ?? 0m, AporteACompartida(), currentTotal);
        }
    }

    /// <summary>
    /// Lo que queda del ingreso del mes (nómina o aporte) sin contar el saldo
    /// inicial. Devuelve null si el ingreso aún no está definido.
    /// </summary>
    private decimal? Restante()
    {
        if (IsCurrentAccountShared)
        {
            if (currentBudget is null) return null;
            return SaldoCalculator.RestanteAporte(currentBudget.Amount, currentTotal);
        }
        else
        {
            if (currentBudget?.Income is not decimal income) return null;
            return SaldoCalculator.RestanteNomina(income, AporteACompartida(), currentTotal);
        }
    }

    // ===== Modales =====

    private async Task OpenOpeningBalanceModal()
    {
        numberModalTitle = "Saldo inicial del mes";
        numberModalError = "";
        numberModalAllowNegative = true;
        numberModalOnSave = async (value) =>
        {
            currentBudget = await Budgets.SetOpeningBalanceAsync(
                selectedAccountId, currentYear, currentMonth, value);
            if (IsCurrentAccountShared) sharedBudgetThisMonth = currentBudget;
        };

        if (currentBudget?.OpeningBalance is decimal existing)
        {
            // Ya tenemos saldo definido: precargamos el actual para editar.
            numberInput = existing;
            numberModalHint = $"Dinero que hay en la cuenta al inicio de {MonthLabel}.";
        }
        else
        {
            // No hay saldo: intentamos sugerir el saldo final del mes anterior.
            var suggestion = await CalcularSaldoFinalMesAnterior();
            numberInput = suggestion;
            numberModalHint = suggestion is null
                ? $"Dinero que había en la cuenta al inicio de {MonthLabel}."
                : $"Sugerencia: saldo final del mes anterior ({FormatMoney(suggestion.Value)}). Ajústalo si no coincide con el banco.";
        }

        numberModalVisible = true;
    }

    /// <summary>
    /// Saldo final calculado del mes inmediatamente anterior, para sugerirlo
    /// como saldo inicial del mes actual.
    ///
    /// No se conforma con mirar solo el mes anterior: retrocede hasta el último
    /// mes que tenga saldo inicial definido (el "ancla") y arrastra el saldo
    /// hacia delante mes a mes hasta el mes anterior, atravesando los meses con
    /// hueco (sin saldo propio). Así un mes sin definir intermedio no rompe la
    /// sugerencia. Devuelve null si no hay ningún mes anterior con saldo.
    /// </summary>
    private async Task<decimal?> CalcularSaldoFinalMesAnterior()
    {
        try
        {
            // Tope de seguridad: no buscar indefinidamente hacia atrás.
            const int maxLookback = 24;

            var prevDate = new DateTime(currentYear, currentMonth, 1).AddMonths(-1);

            // 1) Retroceder hasta el mes ancla (el último con saldo inicial).
            DateTime? anchor = null;
            decimal anchorOpening = 0m;
            var probe = prevDate;
            for (int i = 0; i < maxLookback; i++)
            {
                var b = await Budgets.GetForMonthAsync(selectedAccountId, probe.Year, probe.Month);
                if (b?.OpeningBalance is decimal ob)
                {
                    anchor = probe;
                    anchorOpening = ob;
                    break;
                }
                probe = probe.AddMonths(-1);
            }

            if (anchor is null) return null;

            // 2) Arrastrar el saldo desde el ancla hasta el mes anterior (inclusive).
            //    El mes ancla parte de su propio saldo inicial; cada mes con hueco
            //    posterior parte del saldo final arrastrado del mes anterior.
            decimal running = anchorOpening;
            var cursor = anchor.Value;
            while (true)
            {
                running = await SaldoFinalDeMes(cursor.Year, cursor.Month, running);
                if (cursor.Year == prevDate.Year && cursor.Month == prevDate.Month)
                    break;
                cursor = cursor.AddMonths(1);
            }

            return running;
        }
        catch
        {
            return null;
        }
    }

    /// <summary>
    /// Saldo final de un mes concreto de la cuenta activa, partiendo de un saldo
    /// inicial dado (no necesariamente el guardado: en el arrastre usamos el saldo
    /// arrastrado del mes anterior). Recoge gastos y previsión de ese mes.
    /// </summary>
    private async Task<decimal> SaldoFinalDeMes(int year, int month, decimal opening)
    {
        var budget = await Budgets.GetForMonthAsync(selectedAccountId, year, month);

        var expensesAll = await Expenses.GetByMonthAsync(year, month);
        var spent = expensesAll
            .Where(e => e.AccountId == selectedAccountId)
            .Sum(e => e.Amount);

        if (IsCurrentAccountShared)
        {
            return SaldoCalculator.SaldoFinalCompartida(opening, budget?.Amount ?? 0m, spent);
        }
        else
        {
            var sharedBudget = SharedAccount is null
                ? null
                : await Budgets.GetForMonthAsync(SharedAccount.Id, year, month);
            var aporte = SaldoCalculator.AporteACompartida(sharedBudget?.Amount ?? 0m, MyShareInShared);
            return SaldoCalculator.SaldoFinalPersonal(opening, budget?.Income ?? 0m, aporte, spent);
        }
    }

    private void OpenIncomeModal()
    {
        numberInput = currentBudget?.Income;
        numberModalTitle = "Nómina del mes";
        numberModalHint = $"Ingresos que entran en esta cuenta durante {MonthLabel}.";
        numberModalError = "";
        numberModalAllowNegative = false;
        numberModalOnSave = async (value) =>
        {
            currentBudget = await Budgets.SetIncomeAsync(
                selectedAccountId, currentYear, currentMonth, value);
        };
        numberModalVisible = true;
    }

    private void OpenAmountModal()
    {
        numberInput = currentBudget?.Amount;
        numberModalTitle = "Aporte conjunto del mes";
        numberModalHint = $"Cantidad total que entra en la cuenta compartida en {MonthLabel} (la suma de los dos miembros).";
        numberModalError = "";
        numberModalAllowNegative = false;
        numberModalOnSave = async (value) =>
        {
            currentBudget = await Budgets.SetAmountAsync(
                selectedAccountId, currentYear, currentMonth, value);
            if (IsCurrentAccountShared) sharedBudgetThisMonth = currentBudget;
        };
        numberModalVisible = true;
    }

    private void CloseNumberModal()
    {
        if (isSavingNumber) return;
        numberModalVisible = false;
        numberModalOnSave = null;
    }

    private async Task SaveNumberModal()
    {
        if (numberInput is null || numberModalOnSave is null) return;

        if (!numberModalAllowNegative && numberInput < 0)
        {
            numberModalError = "El valor no puede ser negativo.";
            return;
        }

        isSavingNumber = true;
        numberModalError = "";

        try
        {
            await numberModalOnSave(numberInput.Value);
            numberModalVisible = false;
            numberModalOnSave = null;
        }
        catch (Exception ex)
        {
            numberModalError = "No se pudo guardar. Inténtalo de nuevo.";
            Console.Error.WriteLine(ex.ToString());
        }
        finally
        {
            isSavingNumber = false;
        }
    }

    // ===== Helpers de formato =====

    private static string FormatMoney(decimal amount) => AppFormat.Money(amount);

    private static string SinDefinir() => "—";

    private static string BlockLabel(string block) => Blocks.Label(block);
}
