@page "/categorias"
@using GastosApp.Client.Models
@using GastosApp.Client.Services
@inject AuthService Auth
@inject AccountService Accounts
@inject CategoryService CategorySvc
@inject NavigationManager Nav

<PageTitle>Categorías</PageTitle>

@if (isLoading)
{
    <p>Cargando...</p>
}
else if (accounts.Count == 0)
{
    <p>No tienes cuentas todavía. <a href="setup">Configura tus cuentas</a>.</p>
}
else
{
    <div class="container-narrow stagger">
    <h2>Categorías</h2>

    <AccountTabs Accounts="accounts"
                 SelectedAccountId="selectedAccountId"
                 OnAccountSelected="SelectAccount" />

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @* Formulario inline para crear / editar *@
    @if (showForm)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@(editingId.HasValue ? "Editar categoría" : "Nueva categoría")</h5>

                <div class="mb-2">
                    <label class="form-label">Nombre</label>
                    <input class="form-control" @bind="formName" @bind:event="oninput" />
                </div>

                <div class="mb-2">
                    <label class="form-label">Bloque</label>
                    <select class="form-select" @bind="formBlock">
                        @foreach (var b in BlocksFor(selectedAccountId))
                        {
                            <option value="@b">@BlockLabel(b)</option>
                        }
                    </select>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary" @onclick="HandleSave"
                            disabled="@(isSaving || string.IsNullOrWhiteSpace(formName))">
                        @(isSaving ? "Guardando..." : "Guardar")
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="CancelForm" disabled="@isSaving">
                        Cancelar
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <button class="btn btn-primary mb-3" @onclick="StartNew">
            + Nueva categoría
        </button>
    }

    @* Listado agrupado por bloque *@
    @if (currentCategories.Count == 0)
    {
        <p class="text-muted">Aún no hay categorías en esta cuenta.</p>
    }
    else
    {
        @foreach (var group in currentCategories.GroupBy(c => c.Block).OrderBy(g => BlockOrder(g.Key)))
        {
            <h6 class="cat-group-label">@BlockLabel(group.Key)</h6>
            <ul class="list-group mb-2">
                @foreach (var cat in group.OrderBy(c => c.Name))
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@cat.Name</span>
                        <span class="cat-actions">
                            <button class="icon-btn"
                                    @onclick="() => StartEdit(cat)"
                                    title="Editar" aria-label="Editar categoría">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
                                </svg>
                            </button>
                            <button class="icon-btn icon-btn-danger"
                                    @onclick="() => HandleDelete(cat)"
                                    title="Borrar" aria-label="Borrar categoría">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                    <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                </svg>
                            </button>
                        </span>
                    </li>
                }
            </ul>
        }
    }
    </div>
}

<style>
    .container-narrow {
        max-width: 600px;
        margin: 0 auto;
    }
    .container-narrow > h2 {
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-bottom: 16px;
    }
    .cat-group-label {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        font-weight: 700;
        margin: 20px 0 8px;
    }
    .cat-actions {
        display: inline-flex;
        gap: 6px;
    }
</style>

@code {
    private bool isLoading = true;
    private bool isSaving = false;
    private string errorMessage = "";

    private List<Account> accounts = new();
    private Guid selectedAccountId;
    private List<Category> currentCategories = new();

    // Form state
    private bool showForm = false;
    private Guid? editingId = null;
    private string formName = "";
    private string formBlock = "";

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn)
        {
            Nav.NavigateTo("login");
            return;
        }

        accounts = await Accounts.GetMyAccountsAsync();
        if (accounts.Count == 0)
        {
            isLoading = false;
            return;
        }

        // Ordenamos: personal primero, compartida después
        accounts = accounts.OrderBy(a => a.IsShared).ToList();
        selectedAccountId = accounts.First().Id;
        await LoadCategories();
        isLoading = false;
    }

    private async Task SelectAccount(Guid accountId)
    {
        selectedAccountId = accountId;
        CancelForm();
        await LoadCategories();
    }

    private async Task LoadCategories()
    {
        try
        {
            currentCategories = await CategorySvc.GetByAccountAsync(selectedAccountId);
            errorMessage = "";
        }
        catch (Exception ex)
        {
            errorMessage = "No se pudieron cargar las categorías. Inténtalo de nuevo.";
            Console.Error.WriteLine(ex.ToString());
        }
    }

    private void StartNew()
    {
        editingId = null;
        formName = "";
        formBlock = BlocksFor(selectedAccountId).First();
        showForm = true;
        errorMessage = "";
    }

    private void StartEdit(Category cat)
    {
        editingId = cat.Id;
        formName = cat.Name;

        // Si el bloque de la categoría ya no es un bloque ofrecido para esta
        // cuenta (p. ej. 'individual' legacy en personal), preseleccionamos el
        // primer bloque válido para que al guardar quede migrada.
        var valid = BlocksFor(selectedAccountId);
        formBlock = valid.Contains(cat.Block) ? cat.Block : valid.First();

        showForm = true;
        errorMessage = "";
    }

    private void CancelForm()
    {
        showForm = false;
        editingId = null;
        formName = "";
        formBlock = "";
    }

    private async Task HandleSave()
    {
        if (string.IsNullOrWhiteSpace(formName)) return;

        var trimmedName = formName.Trim();
        var isDuplicate = currentCategories.Any(c =>
            c.Name.Equals(trimmedName, StringComparison.OrdinalIgnoreCase) &&
            c.Id != (editingId ?? Guid.Empty));

        if (isDuplicate)
        {
            errorMessage = $"Ya existe una categoría con el nombre \"{trimmedName}\" en esta cuenta.";
            return;
        }

        isSaving = true;
        errorMessage = "";

        try
        {
            if (editingId.HasValue)
            {
                await CategorySvc.UpdateAsync(editingId.Value, trimmedName, formBlock);
            }
            else
            {
                await CategorySvc.CreateAsync(selectedAccountId, trimmedName, formBlock);
            }

            CancelForm();
            await LoadCategories();
        }
        catch (Exception ex)
        {
            errorMessage = "No se pudo guardar la categoría. Inténtalo de nuevo.";
            Console.Error.WriteLine(ex.ToString());
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task HandleDelete(Category cat)
    {
        errorMessage = "";
        try
        {
            await CategorySvc.DeleteAsync(cat.Id);
            await LoadCategories();
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo borrar \"{cat.Name}\". Si tiene gastos asociados, bórralos primero.";
            Console.Error.WriteLine(ex.ToString());
        }
    }

    private string[] BlocksFor(Guid accountId)
    {
        var acc = accounts.FirstOrDefault(a => a.Id == accountId);
        return Blocks.For(acc?.IsShared == true);
    }

    private static string BlockLabel(string block) => Blocks.Label(block);

    private static int BlockOrder(string block) => Blocks.Order(block);
}
